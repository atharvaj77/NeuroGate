{
    "__inputs": [
        {
            "name": "DS_PROMETHEUS",
            "label": "NeuroGate Prometheus",
            "description": "Prometheus datasource scraping /actuator/prometheus",
            "type": "datasource",
            "pluginId": "prometheus",
            "pluginName": "Prometheus"
        }
    ],
    "__requires": [
        {
            "type": "grafana",
            "id": "grafana",
            "name": "Grafana",
            "version": "10.0.0"
        },
        {
            "type": "datasource",
            "id": "prometheus",
            "name": "Prometheus",
            "version": "1.0.0"
        },
        {
            "type": "panel",
            "id": "timeseries",
            "name": "Time series",
            "version": ""
        },
        {
            "type": "panel",
            "id": "gauge",
            "name": "Gauge",
            "version": ""
        },
        {
            "type": "panel",
            "id": "stat",
            "name": "Stat",
            "version": ""
        }
    ],
    "annotations": {
        "list": []
    },
    "description": "NeuroGate real-time gateway observability — latency, RPS, error rate, cost, cache hits, PII blocks.",
    "editable": true,
    "fiscalYearStartMonth": 0,
    "graphTooltip": 1,
    "id": null,
    "links": [],
    "liveNow": true,
    "panels": [
        {
            "title": "Requests per Second",
            "type": "timeseries",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 0
            },
            "id": 1,
            "datasource": {
                "type": "prometheus",
                "uid": "${DS_PROMETHEUS}"
            },
            "options": {
                "tooltip": {
                    "mode": "single"
                }
            },
            "fieldConfig": {
                "defaults": {
                    "color": {
                        "mode": "palette-classic"
                    },
                    "custom": {
                        "lineWidth": 2,
                        "fillOpacity": 15
                    },
                    "unit": "reqps"
                }
            },
            "targets": [
                {
                    "expr": "rate(neurogate_requests_total[30s])",
                    "legendFormat": "RPS",
                    "refId": "A"
                }
            ]
        },
        {
            "title": "Latency (P50 / P95)",
            "type": "timeseries",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 12,
                "y": 0
            },
            "id": 2,
            "datasource": {
                "type": "prometheus",
                "uid": "${DS_PROMETHEUS}"
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "ms",
                    "custom": {
                        "lineWidth": 2,
                        "fillOpacity": 10
                    }
                }
            },
            "targets": [
                {
                    "expr": "histogram_quantile(0.50, sum(rate(http_server_requests_seconds_bucket[30s])) by (le)) * 1000",
                    "legendFormat": "P50",
                    "refId": "A"
                },
                {
                    "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket[30s])) by (le)) * 1000",
                    "legendFormat": "P95",
                    "refId": "B"
                }
            ]
        },
        {
            "title": "Error Rate (%)",
            "type": "timeseries",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 0,
                "y": 8
            },
            "id": 3,
            "datasource": {
                "type": "prometheus",
                "uid": "${DS_PROMETHEUS}"
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "percentunit",
                    "custom": {
                        "lineWidth": 2
                    },
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            },
                            {
                                "color": "yellow",
                                "value": 0.02
                            },
                            {
                                "color": "red",
                                "value": 0.05
                            }
                        ]
                    }
                }
            },
            "targets": [
                {
                    "expr": "rate(neurogate_provider_errors_total[30s]) / rate(neurogate_requests_total[30s])",
                    "legendFormat": "Error Rate",
                    "refId": "A"
                }
            ]
        },
        {
            "title": "Cache Hit Rate",
            "type": "timeseries",
            "gridPos": {
                "h": 8,
                "w": 12,
                "x": 12,
                "y": 8
            },
            "id": 4,
            "datasource": {
                "type": "prometheus",
                "uid": "${DS_PROMETHEUS}"
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "percentunit",
                    "custom": {
                        "lineWidth": 2,
                        "fillOpacity": 10
                    }
                }
            },
            "targets": [
                {
                    "expr": "rate(neurogate_cache_hits_total[30s]) / rate(neurogate_requests_total[30s])",
                    "legendFormat": "Cache Hit Rate",
                    "refId": "A"
                }
            ]
        },
        {
            "title": "Total Tokens",
            "type": "stat",
            "gridPos": {
                "h": 4,
                "w": 6,
                "x": 0,
                "y": 16
            },
            "id": 5,
            "datasource": {
                "type": "prometheus",
                "uid": "${DS_PROMETHEUS}"
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "short"
                }
            },
            "targets": [
                {
                    "expr": "neurogate_tokens_total",
                    "legendFormat": "Tokens",
                    "refId": "A"
                }
            ]
        },
        {
            "title": "PII Detections",
            "type": "stat",
            "gridPos": {
                "h": 4,
                "w": 6,
                "x": 6,
                "y": 16
            },
            "id": 6,
            "datasource": {
                "type": "prometheus",
                "uid": "${DS_PROMETHEUS}"
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "short",
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "green",
                                "value": null
                            },
                            {
                                "color": "orange",
                                "value": 10
                            },
                            {
                                "color": "red",
                                "value": 50
                            }
                        ]
                    }
                }
            },
            "targets": [
                {
                    "expr": "neurogate_pii_detections_total",
                    "legendFormat": "PII Detections",
                    "refId": "A"
                }
            ]
        },
        {
            "title": "Cumulative Cost (USD)",
            "type": "stat",
            "gridPos": {
                "h": 4,
                "w": 6,
                "x": 12,
                "y": 16
            },
            "id": 7,
            "datasource": {
                "type": "prometheus",
                "uid": "${DS_PROMETHEUS}"
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "currencyUSD",
                    "decimals": 4
                }
            },
            "targets": [
                {
                    "expr": "neurogate_cost_usd_total",
                    "legendFormat": "Cost USD",
                    "refId": "A"
                }
            ]
        },
        {
            "title": "Active WebSocket Clients",
            "type": "stat",
            "gridPos": {
                "h": 4,
                "w": 6,
                "x": 18,
                "y": 16
            },
            "id": 8,
            "datasource": {
                "type": "prometheus",
                "uid": "${DS_PROMETHEUS}"
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "short",
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            {
                                "color": "blue",
                                "value": null
                            }
                        ]
                    }
                }
            },
            "targets": [
                {
                    "expr": "spring_websocket_sessions_total",
                    "legendFormat": "WS Clients",
                    "refId": "A"
                }
            ]
        }
    ],
    "refresh": "5s",
    "schemaVersion": 38,
    "tags": [
        "neurogate",
        "observability",
        "pulse"
    ],
    "templating": {
        "list": []
    },
    "time": {
        "from": "now-30m",
        "to": "now"
    },
    "timepicker": {},
    "timezone": "browser",
    "title": "NeuroGate Pulse Dashboard",
    "uid": "neurogate-pulse-v1",
    "version": 1
}